# ---------------------------------------------------------------------------
# Free mode (default): Ollama runs the models on your own computer, and pages
# are fetched locally with trafilatura. No API keys or payment needed.
#   1. Install Ollama from https://ollama.com and start it.
#   2. ollama pull llama3.2
#   3. ollama pull nomic-embed-text
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama
PAGE_FETCHER=local

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Optional: a separate (ideally larger) model for judging, e.g. qwen2.5:7b
# OLLAMA_EVALUATOR_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Hosted free mode (used by the live demo): Google Gemini's free tier.
# Set LLM_PROVIDER=gemini and add a free key from
# https://aistudio.google.com/apikey (no credit card needed).
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Public demo request limits (0 turns a limit off).
# RATE_LIMIT_PER_HOUR=30
# DAILY_LIMIT=500

# ---------------------------------------------------------------------------
# Paid mode: set LLM_PROVIDER=openai and/or PAGE_FETCHER=contextdev, then add
# the matching keys below.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key
# OPENAI_CHAT_MODEL=gpt-5-mini
# OPENAI_EVALUATOR_MODEL=gpt-5-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# CONTEXT_DEV_API_KEY=your_context_dev_api_key

# Optional local settings
CHROMA_PATH=./chroma_data
FRONTEND_ORIGIN=http://localhost:5173
